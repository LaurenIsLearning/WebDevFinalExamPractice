{
  "name": "animalcollection",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run client\" \"npm run server\"",
    "prod": "npm run build && npm run start",
    "client": "vite",
    "server": "nodemon --inspect server/server.js",
    "build": "vite build",
    "start": "node server/server.js",
    "test": "concurrently \"npm run prod\" \"cypress run\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "http-proxy": "^1.18.1",
    "mongodb": "^5.2.0",
    "mongoose": "^7.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cypress": "^15.7.1",
    "nodemon": "^3.1.0",
    "vite": "^7.2.6"
  }
}
